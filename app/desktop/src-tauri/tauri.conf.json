{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zhiyue",
  "version": "0.1.11",
  "identifier": "com.zhiyue.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zhiyue",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/runtime/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0ODk0NTlFMTQyMkJBMTgKUldRWXVpSVVua1dKOUp3NEJidTloNWVHTnl6TWRkYTE1TGNSMmliNmtTNHB5cW9tV3Z6d0RsWGQK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "basicUi"
      },
      "endpoints": [
        "https://github.com/Hex4C59/Zhiyue/releases/latest/download/latest.json"
      ]
    }
  }
}
