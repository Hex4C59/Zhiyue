{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "build",
    "sourceMap": false,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": [
    "app/web/src/**/*.ts",
    "app/web/shared/**/*.ts",
    "app/web/test/**/*.ts",
    "app/desktop/test/**/*.ts",
    "app/web/vite.config.ts",
    "scripts/**/*.ts"
  ]
}
