{
  "name": "zhiyue",
  "private": true,
  "version": "0.1.0",
  "description": "Zhiyue - local literature management, PDF reading and AI research assistant",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "vite build --config app/web/vite.config.mjs",
    "test": "npm run build:web && node --test app/web/test/*.test.mjs",
    "test:desktop": "node --test app/desktop/test/*.test.mjs",
    "test:downloads": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download.ps1 -RunTests",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download.ps1 doctor",
    "desktop:dev": "npm run build:web && cd app/desktop && tauri dev",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "npm run build:web && npm run desktop:prepare && node scripts/desktop-build.mjs",
    "share": "python scripts/export_share.py"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.5",
    "@vitejs/plugin-vue": "6.0.11",
    "jsdom": "31.0.1",
    "vite": "8.3.8"
  }
}
